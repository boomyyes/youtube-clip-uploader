# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses all security rules: server and worker only.
SUPABASE_SECRET_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Cloudflare R2 (S3 API token with Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clips
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
# Only for Supabase CLI use; the app doesn't read it.
SUPABASE_DB_PASSWORD=

# Optional: start the upload workflow right after an approval (else it runs every 6 hours).
# Fine-grained GitHub token, only this repo, permission "Actions: Read and write". Set both on Vercel.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=boomyyes/youtube-clip-uploader
